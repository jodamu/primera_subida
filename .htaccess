Options -Indexes
RewriteEngine On

RewriteRule (^|/)\. - [F,L]
RewriteRule ^(app|bin|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]
RewriteRule ^(\.env|composer\.(json|lock)|phpunit\.xml|README\.md|CHANGELOG\.md)(/|$) - [F,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
